{
  "name": "beeftv-plugin-sticky-note",
  "version": "0.1.1",
  "description": "Place color-changeable and editable note cards on the canvas, and support creative assistants to create and modify notes directly.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sunnyender-org/beeftv-plugins.git",
    "directory": "plugins/beeftv-plugin-sticky-note"
  },
  "homepage": "https://github.com/Sunnyender-org/beeftv-plugins/tree/main/plugins/beeftv-plugin-sticky-note",
  "keywords": [
    "beeftv-plugin",
    "sticky-note",
    "canvas",
    "template"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "beeftv": {
    "name": "canvas sticky notes",
    "client": "./client/index.js",
    "surfaces": [
      "node"
    ],
    "permissions": [
      "canvas.read",
      "canvas.write"
    ],
    "contributes": {
      "canvasNodes": [
        {
          "id": "sticky-note",
          "label": "canvas sticky notes",
          "defaultTitle": "Notes",
          "defaultSize": {
            "width": 240,
            "height": 180
          },
          "schema": {
            "type": "object",
            "properties": {
              "content": {
                "type": "string"
              },
              "color": {
                "type": "string"
              }
            }
          },
          "renderer": "client",
          "description": "Canvas note cards with switchable colors"
        }
      ]
    }
  },
  "files": [
    "extensions",
    "skills",
    "client",
    "README.md"
  ],
  "author": "BeefTV"
}
