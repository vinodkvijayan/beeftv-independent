{
  "name": "beeftv-plugin-character-replacement",
  "version": "0.1.5",
  "description": "AI character replacement studio: supports single/multiplayer precise character replacement, 5-stop replacement range control, positioning frame SVG assistance, two-stage keyframe + video action replacement (Seedream + Seedance 2.5 element replacement) and lossless back-insertion of the entire film timeline.",
  "author": "BeefTV",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Sunnyender-org/beeftv-plugins/tree/main/plugins/beeftv-plugin-character-replacement",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sunnyender-org/beeftv-plugins.git",
    "directory": "plugins/beeftv-plugin-character-replacement"
  },
  "keywords": [
    "beeftv-plugin",
    "pi-package",
    "character-replacement",
    "person-replacement",
    "short-drama",
    "seedance"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "beeftv": {
    "name": "AI character replacement studio",
    "client": "./client/index.js",
    "surfaces": [
      "node",
      "fullscreen",
      "hybrid"
    ],
    "permissions": [
      "canvas.read",
      "canvas.write",
      "timeline.command"
    ],
    "contributes": {
      "canvasNodes": [
        {
          "id": "character-replacement",
          "label": "Role replacement",
          "defaultTitle": "AI role replacement",
          "defaultSize": {
            "width": 380,
            "height": 460
          },
          "schema": {
            "type": "object",
            "properties": {
              "shotTitle": {
                "type": "string"
              },
              "position": {
                "type": "string",
                "enum": [
                  "single",
                  "left",
                  "center",
                  "right"
                ]
              },
              "genderHint": {
                "type": "string",
                "enum": [
                  "person",
                  "male",
                  "female"
                ]
              },
              "sourceDescription": {
                "type": "string"
              },
              "targetDescription": {
                "type": "string"
              },
              "replacementScope": {
                "type": "string",
                "enum": [
                  "full-person",
                  "visible-part",
                  "face-hair",
                  "clothing",
                  "arm-hand"
                ]
              },
              "promptMode": {
                "type": "string",
                "enum": [
                  "regular",
                  "positioning",
                  "manual"
                ]
              },
              "sourceKeyframeNodeId": {
                "type": "string"
              },
              "targetCharacterNodeId": {
                "type": "string"
              },
              "sourceVideoNodeId": {
                "type": "string"
              }
            }
          },
          "renderer": "client"
        }
      ]
    }
  },
  "files": [
    "extensions",
    "skills",
    "client",
    "README.md"
  ]
}
