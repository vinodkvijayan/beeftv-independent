{
  "name": "beeftv-plugin-runninghub",
  "version": "0.1.0",
  "description": "Connect RunningHub to BeefTV: Your workflows and AI applications are models, and they are used to generate images, videos, and audio directly on the canvas.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sunnyender-org/beeftv-plugins.git",
    "directory": "plugins/beeftv-plugin-runninghub"
  },
  "homepage": "https://github.com/Sunnyender-org/beeftv-plugins/tree/main/plugins/beeftv-plugin-runninghub",
  "keywords": [
    "beeftv-plugin",
    "runninghub",
    "comfyui",
    "workflow",
    "image",
    "video",
    "audio"
  ],
  "beeftv": {
    "name": "RunningHub",
    "contributes": {
      "providers": [
        {
          "id": "runninghub",
          "label": "RunningHub",
          "module": "./provider.mjs",
          "capabilities": [
            "image",
            "video",
            "audio"
          ],
          "scopes": [
            "user.custom-channel",
            "canvas",
            "creation",
            "agent"
          ],
          "baseUrl": "https://www.runninghub.cn",
          "auth": {
            "type": "bearer",
            "field": "apiKey"
          }
        }
      ]
    }
  },
  "files": [
    "provider.mjs",
    "lib",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "author": "BeefTV"
}
