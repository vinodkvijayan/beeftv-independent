{
  "name": "beeftv-plugin-slot-test",
  "version": "0.1.1",
  "description": "Standard reference plug-in that fully demonstrates all 27 BeefTV interface extension bits and 5 types of host events.",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "beeftv-plugin",
    "slot-test",
    "example"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "beeftv": {
    "name": "Full slot demo plugin",
    "client": "./client/index.js",
    "surfaces": [
      "node",
      "fullscreen",
      "hybrid",
      "asset-source",
      "settings"
    ],
    "permissions": [
      "canvas.read",
      "canvas.write",
      "asset.read",
      "asset.search",
      "asset.import",
      "generation.run",
      "timeline.read",
      "timeline.command",
      "export.run",
      "external.open"
    ],
    "configuration": {
      "fields": [
        {
          "name": "greeting",
          "label": "Test greeting",
          "type": "string",
          "default": "Hello BeefTV"
        }
      ]
    },
    "contributes": {
      "canvasNodes": [
        {
          "id": "slot-test-node",
          "label": "Socket test node",
          "defaultTitle": "Socket test node",
          "defaultSize": {
            "width": 260,
            "height": 160
          },
          "schema": {
            "type": "object",
            "properties": {
              "note": {
                "type": "string"
              }
            }
          },
          "renderer": "client"
        }
      ]
    }
  },
  "files": [
    "extensions",
    "skills",
    "client",
    "README.md"
  ],
  "author": "BeefTV"
}
