{
  "name": "beeftv-plugin-ll2",
  "version": "1.0.2",
  "description": "Built-in LL2 (DMC) computing power and video channel plug-in, supports one-click synchronization of DeepSeek V4.1, Seedance 2.0, Vidu Q3, MiniMax H3, Super Vega 1.0 and Auto HD super-resolution models by filling in the API Key.",
  "type": "module",
  "main": "./client/index.js",
  "license": "Apache-2.0",
  "keywords": [
    "beeftv-plugin",
    "ll2",
    "video",
    "seedance",
    "vidu",
    "super-vega"
  ],
  "beeftv": {
    "name": "LL2 computing power and video channels",
    "client": "./client/index.js",
    "permissions": [
      "generation.run",
      "media.read",
      "ui.slot",
      "settings.write"
    ],
    "configuration": {
      "fields": [
        {
          "name": "apiKey",
          "type": "secret",
          "label": "LL2 API Key",
          "required": true,
          "description": "Fill in LL2 (sk-... key provided by https://api.ll2.cn)"
        },
        {
          "name": "baseUrl",
          "type": "string",
          "label": "Base URL",
          "required": false,
          "default": "https://api.ll2.cn",
          "description": "LL2 interface root address, default https://api.ll2.cn"
        }
      ]
    },
    "contributes": {
      "providers": [
        {
          "id": "ll2-seedance-video",
          "label": "LL2 Seedance 2.0 Video",
          "capabilities": [
            "video"
          ],
          "scopes": [
            "admin.system-channel",
            "user.custom-channel",
            "canvas",
            "creation",
            "agent"
          ],
          "baseUrl": "https://api.ll2.cn",
          "requiresPublicMediaUrls": false,
          "mediaTransport": {
            "image": "inline",
            "video": "url",
            "audio": "url"
          },
          "auth": {
            "type": "bearer",
            "field": "apiKey"
          },
          "parameters": [
            {
              "name": "model",
              "type": "string",
              "required": true,
              "mapping": "model",
              "description": "Seedance 2.0 model ID (e.g. doubao-seedance-2-0, doubao-seedance-2-0-fast)."
            },
            {
              "name": "prompt",
              "type": "string",
              "required": true,
              "mapping": "content[type=text].text",
              "description": "Video prompt words."
            },
            {
              "name": "images",
              "type": "media[]",
              "required": false,
              "mapping": "content[type=image_url]",
              "description": "The first frame, last frame, reference picture, etc. role are mapped as they are."
            },
            {
              "name": "videos",
              "type": "media[]",
              "required": false,
              "mapping": "content[type=video_url]",
              "description": "Reference video."
            },
            {
              "name": "audios",
              "type": "media[]",
              "required": false,
              "mapping": "content[type=audio_url]",
              "description": "Reference audio."
            },
            {
              "name": "aspectRatio",
              "type": "string",
              "required": false,
              "mapping": "ratio",
              "description": "Output aspect ratio."
            },
            {
              "name": "resolution",
              "type": "string",
              "required": false,
              "mapping": "resolution",
              "description": "Output resolution gear (480p, 720p)."
            },
            {
              "name": "duration",
              "type": "integer",
              "required": false,
              "mapping": "duration",
              "description": "Output duration in seconds (4-15 seconds)."
            },
            {
              "name": "generateAudio",
              "type": "boolean",
              "required": false,
              "mapping": "generate_audio",
              "description": "Whether to generate audio."
            },
            {
              "name": "watermark",
              "type": "boolean",
              "required": false,
              "mapping": "watermark",
              "description": "Whether to include watermark."
            }
          ],
          "create": {
            "method": "POST",
            "path": "/seedance/api/v3/contents/generations/tasks",
            "originPath": true,
            "contentType": "application/json",
            "body": {
              "model": {
                "$ref": "request.model"
              },
              "content": {
                "$concatArrays": [
                  [
                    {
                      "type": "text",
                      "text": {
                        "$ref": "request.prompt"
                      }
                    }
                  ],
                  {
                    "$map": {
                      "from": {
                        "$sortByOrder": {
                          "$ref": "request.images"
                        }
                      },
                      "as": "media",
                      "in": {
                        "type": "image_url",
                        "image_url": {
                          "url": {
                            "$ref": "media.value"
                          }
                        },
                        "role": {
                          "$coalesce": [
                            {
                              "$ref": "media.role"
                            },
                            "reference_image"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "$map": {
                      "from": {
                        "$sortByOrder": {
                          "$ref": "request.videos"
                        }
                      },
                      "as": "media",
                      "in": {
                        "type": "video_url",
                        "video_url": {
                          "url": {
                            "$ref": "media.value"
                          }
                        },
                        "role": {
                          "$coalesce": [
                            {
                              "$ref": "media.role"
                            },
                            "reference_video"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "$map": {
                      "from": {
                        "$sortByOrder": {
                          "$ref": "request.audios"
                        }
                      },
                      "as": "media",
                      "in": {
                        "type": "audio_url",
                        "audio_url": {
                          "url": {
                            "$ref": "media.value"
                          }
                        },
                        "role": {
                          "$coalesce": [
                            {
                              "$ref": "media.role"
                            },
                            "reference_audio"
                          ]
                        }
                      }
                    }
                  }
                ]
              },
              "ratio": {
                "$coalesce": [
                  {
                    "$ref": "request.aspectRatio"
                  },
                  "16:9"
                ]
              },
              "resolution": {
                "$coalesce": [
                  {
                    "$lower": {
                      "$ref": "request.resolution"
                    }
                  },
                  "720p"
                ]
              },
              "duration": {
                "$if": {
                  "condition": {
                    "$or": [
                      {
                        "$gt": [
                          {
                            "$ref": "request.duration"
                          },
                          0
                        ]
                      },
                      {
                        "$eq": [
                          {
                            "$ref": "request.duration"
                          },
                          -1
                        ]
                      }
                    ]
                  },
                  "then": {
                    "$ref": "request.duration"
                  },
                  "else": 5
                }
              },
              "generate_audio": {
                "$ref": "request.generateAudio"
              },
              "watermark": {
                "$ref": "request.watermark"
              }
            }
          },
          "poll": {
            "method": "GET",
            "path": "/seedance/api/v3/contents/generations/tasks/{{taskId}}",
            "originPath": true
          },
          "cancel": {
            "method": "DELETE",
            "path": "/seedance/api/v3/contents/generations/tasks/{{taskId}}",
            "originPath": true
          },
          "response": {
            "taskId": {
              "$coalesce": [
                {
                  "$ref": "response.id"
                },
                {
                  "$ref": "response.task_id"
                },
                {
                  "$ref": "response.data.id"
                },
                {
                  "$ref": "taskId"
                }
              ]
            },
            "status": {
              "$coalesce": [
                {
                  "$ref": "response.status"
                },
                {
                  "$ref": "response.data.status"
                },
                "pending"
              ]
            },
            "message": {
              "$coalesce": [
                {
                  "$ref": "response.error.message"
                },
                {
                  "$ref": "response.message"
                },
                {
                  "$ref": "response.fail_reason"
                }
              ]
            },
            "videos": {
              "$coalesce": [
                {
                  "$ref": "response.content.video_url"
                },
                {
                  "$ref": "response.video_url"
                },
                {
                  "$ref": "response.output.video_url"
                },
                {
                  "$ref": "response.data.video_url"
                }
              ]
            },
            "usage": {
              "$ref": "response.usage"
            },
            "errorPaths": [
              "error.code"
            ],
            "resultEphemeral": true
          }
        },
        {
          "id": "ll2-vidu-video",
          "label": "LL2 Vidu Q3 Video",
          "capabilities": [
            "video"
          ],
          "scopes": [
            "admin.system-channel",
            "user.custom-channel",
            "canvas",
            "creation",
            "agent"
          ],
          "baseUrl": "https://api.ll2.cn",
          "requiresPublicMediaUrls": false,
          "mediaTransport": {
            "image": "inline"
          },
          "auth": {
            "type": "bearer",
            "field": "apiKey"
          },
          "parameters": [
            {
              "name": "model",
              "type": "string",
              "required": true,
              "mapping": "model",
              "description": "Vidu video model ID (such as viduq3-pro, viduq3-turbo)."
            },
            {
              "name": "prompt",
              "type": "string",
              "required": false,
              "mapping": "prompt",
              "description": "Video prompt words."
            },
            {
              "name": "images",
              "type": "media[]",
              "required": false,
              "mapping": "images",
              "description": "Explicit role image input (first_frame, last_frame, reference_image)."
            },
            {
              "name": "duration",
              "type": "integer",
              "required": false,
              "mapping": "duration",
              "description": "Duration in seconds (1-16 seconds)."
            },
            {
              "name": "aspectRatio",
              "type": "string",
              "required": false,
              "mapping": "aspect_ratio",
              "description": "Aspect ratio (16:9, 9:16, 4:3, 3:4, 1:1)."
            },
            {
              "name": "resolution",
              "type": "string",
              "required": false,
              "mapping": "resolution",
              "description": "Resolution levels (540p, 720p, 1080p)."
            },
            {
              "name": "generateAudio",
              "type": "boolean",
              "required": false,
              "mapping": "audio",
              "description": "Whether audio and video are streamed directly."
            },
            {
              "name": "watermark",
              "type": "boolean",
              "required": false,
              "mapping": "watermark",
              "description": "Watermark switch."
            }
          ],
          "create": {
            "method": "POST",
            "path": "/vidu/ent/v2/text2video",
            "originPath": true,
            "pathTemplate": {
              "$if": {
                "condition": {
                  "$or": [
                    {
                      "$gt": [
                        {
                          "$len": {
                            "$filter": {
                              "from": {
                                "$ref": "request.images"
                              },
                              "as": "image",
                              "where": {
                                "$eq": [
                                  {
                                    "$ref": "image.role"
                                  },
                                  "last_frame"
                                ]
                              }
                            }
                          }
                        },
                        0
                      ]
                    },
                    {
                      "$gte": [
                        {
                          "$len": {
                            "$ref": "request.images"
                          }
                        },
                        2
                      ]
                    }
                  ]
                },
                "then": "/vidu/ent/v2/start-end2video",
                "else": {
                  "$if": {
                    "condition": {
                      "$gt": [
                        {
                          "$len": {
                            "$ref": "request.images"
                          }
                        },
                        0
                      ]
                    },
                    "then": "/vidu/ent/v2/img2video",
                    "else": "/vidu/ent/v2/text2video"
                  }
                }
              }
            },
            "contentType": "application/json",
            "body": {
              "model": {
                "$ref": "request.model"
              },
              "prompt": {
                "$omitEmpty": {
                  "$ref": "request.prompt"
                }
              },
              "images": {
                "$omitEmpty": {
                  "$map": {
                    "from": {
                      "$sortByOrder": {
                        "$ref": "request.images"
                      }
                    },
                    "as": "media",
                    "in": {
                      "$ref": "media.value"
                    }
                  }
                }
              },
              "duration": {
                "$omitEmpty": {
                  "$ref": "request.duration"
                }
              },
              "aspect_ratio": {
                "$if": {
                  "condition": {
                    "$or": [
                      {
                        "$eq": [
                          {
                            "$len": {
                              "$ref": "request.images"
                            }
                          },
                          0
                        ]
                      },
                      {
                        "$gt": [
                          {
                            "$len": {
                              "$filter": {
                                "from": {
                                  "$ref": "request.images"
                                },
                                "as": "image",
                                "where": {
                                  "$in": [
                                    {
                                      "$ref": "image.role"
                                    },
                                    [
                                      "reference_image",
                                      "subject_reference",
                                      "style_reference"
                                    ]
                                  ]
                                }
                              }
                            }
                          },
                          0
                        ]
                      }
                    ]
                  },
                  "then": {
                    "$omitEmpty": {
                      "$ref": "request.aspectRatio"
                    }
                  }
                }
              },
              "resolution": {
                "$omitEmpty": {
                  "$lower": {
                    "$ref": "request.resolution"
                  }
                }
              },
              "audio": {
                "$if": {
                  "condition": {
                    "$ref": "request.generateAudio"
                  },
                  "then": true
                }
              },
              "watermark": {
                "$if": {
                  "condition": {
                    "$ref": "request.watermark"
                  },
                  "then": true
                }
              }
            }
          },
          "poll": {
            "method": "GET",
            "path": "/vidu/ent/v2/tasks/{{taskId}}/creations",
            "originPath": true
          },
          "response": {
            "taskId": {
              "$coalesce": [
                {
                  "$ref": "response.task_id"
                },
                {
                  "$ref": "response.id"
                },
                {
                  "$ref": "response.taskId"
                },
                {
                  "$ref": "taskId"
                }
              ]
            },
            "status": {
              "$coalesce": [
                {
                  "$ref": "response.state"
                },
                {
                  "$ref": "response.status"
                },
                "pending"
              ]
            },
            "message": {
              "$coalesce": [
                {
                  "$ref": "response.err_code"
                },
                {
                  "$ref": "response.error.message"
                },
                {
                  "$ref": "response.message"
                }
              ]
            },
            "videos": {
              "$coalesce": [
                {
                  "$map": {
                    "from": {
                      "$ref": "response.creations"
                    },
                    "as": "item",
                    "in": {
                      "$ref": "item.url"
                    }
                  }
                },
                {
                  "$ref": "response.video_url"
                },
                {
                  "$ref": "response.url"
                }
              ]
            },
            "errorPaths": [
              "err_code",
              "error.code"
            ],
            "resultEphemeral": true
          }
        },
        {
          "id": "ll2-minimax-video",
          "label": "LL2 MiniMax H3 Video",
          "capabilities": [
            "video"
          ],
          "scopes": [
            "admin.system-channel",
            "user.custom-channel",
            "canvas",
            "creation",
            "agent"
          ],
          "baseUrl": "https://api.ll2.cn",
          "requiresPublicMediaUrls": true,
          "mediaTransport": {
            "image": "url",
            "video": "url",
            "audio": "url"
          },
          "auth": {
            "type": "bearer",
            "field": "apiKey"
          },
          "parameters": [
            {
              "name": "model",
              "type": "string",
              "required": true,
              "mapping": "model",
              "description": "MiniMax video model ID (such as MiniMax-H3)."
            },
            {
              "name": "prompt",
              "type": "string",
              "required": true,
              "mapping": "content[type=text].text",
              "description": "Video prompt words."
            },
            {
              "name": "images",
              "type": "media[]",
              "mapping": "content[type=image_url]",
              "description": "Support first_frame, last_frame, reference_image."
            },
            {
              "name": "videos",
              "type": "media[]",
              "mapping": "content[type=video_url]",
              "description": "Reference video."
            },
            {
              "name": "audios",
              "type": "media[]",
              "mapping": "content[type=audio_url]",
              "description": "Reference audio."
            },
            {
              "name": "duration",
              "type": "integer",
              "required": true,
              "mapping": "duration",
              "description": "4-15 seconds."
            },
            {
              "name": "resolution",
              "type": "string",
              "mapping": "resolution",
              "description": "Fixed support for 768P."
            },
            {
              "name": "aspectRatio",
              "type": "string",
              "mapping": "ratio",
              "description": "Aspect ratio."
            }
          ],
          "create": {
            "method": "POST",
            "path": "/v2/video_generation",
            "originPath": true,
            "contentType": "application/json",
            "body": {
              "model": {
                "$ref": "request.model"
              },
              "content": {
                "$concatArrays": [
                  [
                    {
                      "type": "text",
                      "text": {
                        "$ref": "request.prompt"
                      }
                    }
                  ],
                  {
                    "$map": {
                      "from": {
                        "$sortByOrder": {
                          "$ref": "request.images"
                        }
                      },
                      "as": "media",
                      "in": {
                        "type": "image_url",
                        "image_url": {
                          "url": {
                            "$ref": "media.value"
                          }
                        },
                        "role": {
                          "$coalesce": [
                            {
                              "$ref": "media.role"
                            },
                            "reference_image"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "$map": {
                      "from": {
                        "$sortByOrder": {
                          "$ref": "request.videos"
                        }
                      },
                      "as": "media",
                      "in": {
                        "type": "video_url",
                        "video_url": {
                          "url": {
                            "$ref": "media.value"
                          }
                        },
                        "role": {
                          "$coalesce": [
                            {
                              "$ref": "media.role"
                            },
                            "reference_video"
                          ]
                        }
                      }
                    }
                  },
                  {
                    "$map": {
                      "from": {
                        "$sortByOrder": {
                          "$ref": "request.audios"
                        }
                      },
                      "as": "media",
                      "in": {
                        "type": "audio_url",
                        "audio_url": {
                          "url": {
                            "$ref": "media.value"
                          }
                        },
                        "role": {
                          "$coalesce": [
                            {
                              "$ref": "media.role"
                            },
                            "reference_audio"
                          ]
                        }
                      }
                    }
                  }
                ]
              },
              "duration": {
                "$coalesce": [
                  {
                    "$ref": "request.duration"
                  },
                  5
                ]
              },
              "resolution": "768P",
              "ratio": {
                "$if": {
                  "condition": {
                    "$gt": [
                      {
                        "$len": {
                          "$filter": {
                            "from": {
                              "$ref": "request.images"
                            },
                            "as": "image",
                            "where": {
                              "$in": [
                                {
                                  "$ref": "image.role"
                                },
                                [
                                  "first_frame",
                                  "last_frame"
                                ]
                              ]
                            }
                          }
                        }
                      },
                      0
                    ]
                  },
                  "then": "adaptive",
                  "else": {
                    "$coalesce": [
                      {
                        "$ref": "request.aspectRatio"
                      },
                      "16:9"
                    ]
                  }
                }
              }
            }
          },
          "poll": {
            "method": "GET",
            "path": "/v2/query/video_generation/{{taskId}}",
            "originPath": true
          },
          "response": {
            "taskId": {
              "$coalesce": [
                {
                  "$ref": "response.task.id"
                },
                {
                  "$ref": "response.task_id"
                },
                {
                  "$ref": "response.id"
                },
                {
                  "$ref": "taskId"
                }
              ]
            },
            "status": {
              "$coalesce": [
                {
                  "$ref": "response.task.status"
                },
                {
                  "$ref": "response.status"
                },
                "pending"
              ]
            },
            "message": {
              "$coalesce": [
                {
                  "$ref": "response.task.error.message"
                },
                {
                  "$ref": "response.base_resp.status_msg"
                },
                {
                  "$ref": "response.error.message"
                },
                {
                  "$ref": "response.message"
                }
              ]
            },
            "videos": {
              "$coalesce": [
                {
                  "$ref": "response.task.content.url"
                },
                {
                  "$ref": "response.content.url"
                },
                {
                  "$ref": "response.video_url"
                },
                {
                  "$ref": "response.file.download_url"
                }
              ]
            },
            "errorPaths": [
              "task.error.code",
              "base_resp.status_code",
              "error.code"
            ],
            "resultEphemeral": true
          }
        },
        {
          "id": "ll2-super-vega-video",
          "label": "LL2 Super Vega Video",
          "capabilities": [
            "video"
          ],
          "scopes": [
            "admin.system-channel",
            "user.custom-channel",
            "canvas",
            "creation",
            "agent"
          ],
          "baseUrl": "https://api.ll2.cn",
          "requiresPublicMediaUrls": true,
          "mediaTransport": {
            "image": "url",
            "video": "url",
            "audio": "url"
          },
          "auth": {
            "type": "bearer",
            "field": "apiKey"
          },
          "parameters": [
            {
              "name": "model",
              "type": "string",
              "required": true,
              "mapping": "model",
              "description": "Super Vega video model ID (e.g. Super Vega 1.0-pro-mini, Super Vega 1.0-lite)."
            },
            {
              "name": "prompt",
              "type": "string",
              "required": false,
              "mapping": "Prompt",
              "description": "Video prompt words."
            },
            {
              "name": "images",
              "type": "media[]",
              "required": false,
              "mapping": "FileInfos",
              "description": "The first frame, last frame and reference image are written to FileInfos(Category=Image, Usage=FirstFrame|LastFrame|Reference)."
            },
            {
              "name": "videos",
              "type": "media[]",
              "required": false,
              "mapping": "FileInfos",
              "description": "Reference video is written to FileInfos(Category=Video)."
            },
            {
              "name": "audios",
              "type": "media[]",
              "required": false,
              "mapping": "FileInfos",
              "description": "Reference audio is written to FileInfos(Category=Audio)."
            },
            {
              "name": "duration",
              "type": "integer",
              "required": false,
              "mapping": "OutputConfig.Duration",
              "description": "Duration in seconds (4-15 seconds)."
            },
            {
              "name": "aspectRatio",
              "type": "string",
              "required": false,
              "mapping": "OutputConfig.AspectRatio",
              "description": "Aspect ratio (16:9, 9:16, 4:3, 3:4, 1:1, 21:9)."
            },
            {
              "name": "resolution",
              "type": "string",
              "required": false,
              "mapping": "OutputConfig.Resolution",
              "description": "Resolution gears (720P, 768P, 1080P)."
            },
            {
              "name": "generateAudio",
              "type": "boolean",
              "required": false,
              "mapping": "OutputConfig.AudioGeneration",
              "description": "Audio and video output simultaneously (Enabled; automatically omitted in 1.0-lite)."
            }
          ],
          "create": {
            "method": "POST",
            "path": "/super-vega/tasks",
            "originPath": true,
            "contentType": "application/json",
            "body": {
              "model": {
                "$if": {
                  "condition": {
                    "$eq": [
                      {
                        "$ref": "request.model"
                      },
                      "1.0-pro-mini"
                    ]
                  },
                  "then": "Super Vega 1.0-pro-mini",
                  "else": {
                    "$if": {
                      "condition": {
                        "$eq": [
                          {
                            "$ref": "request.model"
                          },
                          "1.0-lite"
                        ]
                      },
                      "then": "Super Vega 1.0-lite",
                      "else": {
                        "$ref": "request.model"
                      }
                    }
                  }
                }
              },
              "Prompt": {
                "$omitEmpty": {
                  "$ref": "request.prompt"
                }
              },
              "FileInfos": {
                "$omitEmpty": {
                  "$concatArrays": [
                    {
                      "$map": {
                        "from": {
                          "$sortByOrder": {
                            "$ref": "request.images"
                          }
                        },
                        "as": "media",
                        "in": {
                          "Type": "Url",
                          "Category": "Image",
                          "Url": {
                            "$ref": "media.value"
                          },
                          "Usage": {
                            "$if": {
                              "condition": {
                                "$eq": [
                                  {
                                    "$ref": "media.role"
                                  },
                                  "first_frame"
                                ]
                              },
                              "then": "FirstFrame",
                              "else": {
                                "$if": {
                                  "condition": {
                                    "$eq": [
                                      {
                                        "$ref": "media.role"
                                      },
                                      "last_frame"
                                    ]
                                  },
                                  "then": "LastFrame",
                                  "else": "Reference"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    {
                      "$map": {
                        "from": {
                          "$sortByOrder": {
                            "$ref": "request.videos"
                          }
                        },
                        "as": "media",
                        "in": {
                          "Type": "Url",
                          "Category": "Video",
                          "Url": {
                            "$ref": "media.value"
                          }
                        }
                      }
                    },
                    {
                      "$map": {
                        "from": {
                          "$sortByOrder": {
                            "$ref": "request.audios"
                          }
                        },
                        "as": "media",
                        "in": {
                          "Type": "Url",
                          "Category": "Audio",
                          "Url": {
                            "$ref": "media.value"
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "OutputConfig": {
                "StorageMode": "Temporary",
                "Resolution": {
                  "$if": {
                    "condition": {
                      "$and": [
                        {
                          "$in": [
                            {
                              "$ref": "request.model"
                            },
                            [
                              "1.0-lite",
                              "Super Vega 1.0-lite"
                            ]
                          ]
                        },
                        {
                          "$in": [
                            {
                              "$upper": {
                                "$ref": "request.resolution"
                              }
                            },
                            [
                              "",
                              "720P"
                            ]
                          ]
                        }
                      ]
                    },
                    "then": "768P",
                    "else": {
                      "$coalesce": [
                        {
                          "$upper": {
                            "$ref": "request.resolution"
                          }
                        },
                        "720P"
                      ]
                    }
                  }
                },
                "Duration": {
                  "$coalesce": [
                    {
                      "$ref": "request.duration"
                    },
                    5
                  ]
                },
                "AspectRatio": {
                  "$coalesce": [
                    {
                      "$ref": "request.aspectRatio"
                    },
                    "16:9"
                  ]
                },
                "AudioGeneration": {
                  "$if": {
                    "condition": {
                      "$and": [
                        {
                          "$ref": "request.generateAudio"
                        },
                        {
                          "$not": {
                            "$in": [
                              {
                                "$ref": "request.model"
                              },
                              [
                                "1.0-lite",
                                "Super Vega 1.0-lite"
                              ]
                            ]
                          }
                        }
                      ]
                    },
                    "then": "Enabled"
                  }
                }
              }
            }
          },
          "poll": {
            "method": "GET",
            "path": "/super-vega/tasks/{{taskId}}",
            "originPath": true
          },
          "response": {
            "taskId": {
              "$coalesce": [
                {
                  "$ref": "response.Response.TaskId"
                },
                {
                  "$ref": "response.Response.AigcVideoTask.TaskId"
                },
                {
                  "$ref": "response.TaskId"
                },
                {
                  "$ref": "response.id"
                },
                {
                  "$ref": "taskId"
                }
              ]
            },
            "status": {
              "$if": {
                "condition": {
                  "$gt": [
                    {
                      "$ref": "response.Response.AigcVideoTask.ErrCode"
                    },
                    0
                  ]
                },
                "then": "failed",
                "else": {
                  "$coalesce": [
                    {
                      "$ref": "response.Response.AigcVideoTask.Status"
                    },
                    {
                      "$ref": "response.Response.Status"
                    },
                    {
                      "$ref": "response.Status"
                    },
                    {
                      "$ref": "response.status"
                    },
                    "pending"
                  ]
                }
              }
            },
            "message": {
              "$coalesce": [
                {
                  "$ref": "response.Response.Error.Message"
                },
                {
                  "$ref": "response.Response.AigcVideoTask.Message"
                },
                {
                  "$ref": "response.error.message"
                },
                {
                  "$ref": "response.message"
                }
              ]
            },
            "videos": {
              "$coalesce": [
                {
                  "$map": {
                    "from": {
                      "$ref": "response.Response.AigcVideoTask.Output.FileInfos"
                    },
                    "as": "file",
                    "in": {
                      "$ref": "file.FileUrl"
                    }
                  }
                },
                {
                  "$ref": "response.video_url"
                },
                {
                  "$ref": "response.url"
                }
              ]
            },
            "errorPaths": [
              "Response.Error.Code",
              "Response.AigcVideoTask.ErrCode",
              "error.code"
            ],
            "resultEphemeral": true
          }
        },
        {
          "id": "ll2-auto-hd-video",
          "label": "LL2 Auto HD video super score",
          "capabilities": [
            "video"
          ],
          "scopes": [
            "admin.system-channel",
            "user.custom-channel",
            "canvas",
            "creation",
            "agent"
          ],
          "baseUrl": "https://api.ll2.cn",
          "requiresPublicMediaUrls": true,
          "mediaTransport": {
            "video": "url"
          },
          "auth": {
            "type": "bearer",
            "field": "apiKey"
          },
          "parameters": [
            {
              "name": "model",
              "type": "string",
              "required": true,
              "mapping": "model",
              "description": "Model name (auto-hd)."
            },
            {
              "name": "videos",
              "type": "media[]",
              "required": true,
              "mapping": "video_url",
              "description": "The public URL of the video to be super-resolution (take the first reference video)."
            },
            {
              "name": "resolution",
              "type": "string",
              "required": true,
              "mapping": "resolution",
              "description": "Target clarity (720p, 1080p, 2k, 4k)."
            }
          ],
          "validations": [
            {
              "assert": {
                "$gte": [
                  {
                    "$len": {
                      "$ref": "request.videos"
                    }
                  },
                  1
                ]
              },
              "message": "Auto-hd video super score requires 1 reference video"
            }
          ],
          "create": {
            "method": "POST",
            "path": "/hd/tasks",
            "originPath": true,
            "contentType": "application/json",
            "body": {
              "model": {
                "$ref": "request.model"
              },
              "video_url": {
                "$first": {
                  "$map": {
                    "from": {
                      "$sortByOrder": {
                        "$ref": "request.videos"
                      }
                    },
                    "as": "media",
                    "in": {
                      "$ref": "media.value"
                    }
                  }
                }
              },
              "resolution": {
                "$coalesce": [
                  {
                    "$lower": {
                      "$ref": "request.resolution"
                    }
                  },
                  "1080p"
                ]
              },
              "duration": {
                "$coalesce": [
                  {
                    "$ref": "request.duration"
                  },
                  5
                ]
              }
            }
          },
          "poll": {
            "method": "GET",
            "path": "/hd/tasks/{{taskId}}",
            "originPath": true
          },
          "response": {
            "taskId": {
              "$coalesce": [
                {
                  "$ref": "response.id"
                },
                {
                  "$ref": "response.task_id"
                },
                {
                  "$ref": "taskId"
                }
              ]
            },
            "status": {
              "$coalesce": [
                {
                  "$ref": "response.status"
                },
                "pending"
              ]
            },
            "message": {
              "$coalesce": [
                {
                  "$ref": "response.error.message"
                },
                {
                  "$ref": "response.message"
                }
              ]
            },
            "videos": {
              "$coalesce": [
                {
                  "$ref": "response.url"
                },
                {
                  "$ref": "response.video_url"
                }
              ]
            },
            "errorPaths": [
              "error.code"
            ],
            "resultEphemeral": true
          }
        }
      ]
    }
  },
  "author": "BeefTV"
}
