{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beeftv.app/schemas/interface-manifest.schema.json",
  "title": "BeefTV interface plug-in manifest",
  "description": "Describe the request format of a model service: how to send a request, how to check the progress, and how to get the results. The complete verification is based on `beeftv plugin validate`. This schema is used for editor prompts.",
  "type": "object",
  "required": ["apiVersion", "id", "name", "version", "contributes"],
  "properties": {
    "$schema": { "type": "string" },
    "apiVersion": { "enum": ["beeftv.plugin/v1", "beeftv.plugin/v2", "beeftv.plugin/v3"], "description": "When using variables, defaultPathPrefix or image stream response, write v3." },
    "id": { "$ref": "#/$defs/identifier", "description": "Plugin ID, lowercase letters, numbers, - _ ., no more than 96 characters." },
    "name": { "type": "string", "minLength": 1, "maxLength": 160 },
    "version": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "maxLength": 120 },
    "description": { "type": "string" },
    "documentation": { "type": "string" },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "configuration": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "label": { "type": "string" },
              "required": { "type": "boolean" },
              "secret": { "type": "boolean" },
              "default": {}
            }
          }
        }
      }
    },
    "contributes": {
      "type": "object",
      "properties": {
        "providers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/provider" } },
        "workflows": { "type": "array", "items": { "$ref": "#/$defs/workflow" } }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$" },
    "capability": { "enum": ["text", "image", "video", "audio"] },
    "scope": { "enum": ["admin.system-channel", "user.custom-channel", "canvas", "creation", "agent"] },
    "operation": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": { "type": "string", "description": "GET, POST, etc." },
        "path": { "type": "string", "description": "Request path, such as /v1/chat/completions; available {{model}}, {{taskId}}." },
        "pathTemplate": {},
        "defaultPathPrefix": { "type": "string" },
        "originPath": { "type": "boolean" },
        "contentType": { "type": "string" },
        "contentTypeTemplate": {},
        "headers": { "type": "object" },
        "query": { "type": "object" },
        "body": { "description": "Request body template, use $ref, $coalesce, $map and other expressions to get the fields in the unified request." },
        "fields": { "type": "object" },
        "files": { "type": "array" }
      }
    },
    "provider": {
      "type": "object",
      "required": ["id", "label", "capabilities", "scopes"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier", "description": "The interface ID is what is saved in the model settings." },
        "label": { "type": "string", "minLength": 1 },
        "legacyAliases": { "type": "array", "items": { "$ref": "#/$defs/identifier" }, "description": "The ID previously used by this interface. Saved models with old IDs will still be used here, and providerOptions under the old namespace will still take effect." },
        "presets": {
          "type": "array",
          "description": "Service providers that speak the same interface. Users can bring up their name and address in \"Select Service Provider\" with one click.",
          "items": {
            "type": "object",
            "required": ["id", "label", "baseUrl"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "label": { "type": "string", "minLength": 1 },
              "baseUrl": { "type": "string", "pattern": "^https?://[^\\s?#@]+$" }
            },
            "additionalProperties": false
          }
        },
        "capabilities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/capability" } },
        "scopes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scope" } },
        "baseUrl": { "type": "string", "description": "Default service address; users can change it in the connection." },
        "requiresPublicMediaUrls": { "type": "boolean" },
        "mediaTransport": { "type": "object", "additionalProperties": { "type": "string" } },
        "mediaUpload": {
          "type": "object",
          "description": "The reference material upload interface provided by the service provider. After configuration, local or inline reference materials will be uploaded to this interface first in exchange for an online URL before submitting a generation request.",
          "properties": {
            "url": { "type": "string" },
            "path": { "type": "string" },
            "field": { "type": "string" },
            "maxBytes": { "type": "integer" },
            "urlPaths": { "type": "array", "items": { "type": "string" } },
            "errorPaths": { "type": "array", "items": { "type": "string" } },
            "successCodes": { "type": "array" },
            "messagePaths": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "auth": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "description": "bearer, header, query, basic, none, or manufacturer signature method." },
            "field": { "type": "string" },
            "secretField": { "type": "string" },
            "header": { "type": "string" },
            "prefix": { "type": "string" },
            "query": { "type": "string" },
            "username": { "type": "string" },
            "service": { "type": "string" },
            "region": { "type": "string" }
          }
        },
        "parameters": {
          "type": "array",
          "description": "Parameter description written for people who read the plug-in, BeefTV does not read it.",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "validations": {
          "type": "array",
          "items": { "type": "object", "required": ["assert", "message"], "properties": { "assert": {}, "message": { "type": "string" } } }
        },
        "variables": { "type": "array" },
        "create": { "$ref": "#/$defs/operation" },
        "agent": { "$ref": "#/$defs/operation" },
        "poll": { "$ref": "#/$defs/operation" },
        "cancel": { "$ref": "#/$defs/operation" },
        "result": { "$ref": "#/$defs/operation" },
        "response": { "type": "object", "description": "Get the task number, status, text or media address from the upstream response." },
        "agentResponse": { "type": "object" },
        "module": { "type": "string", "description": "The JS file that implements submit/query in the plug-in package; when it is written, create and poll are not written." }
      },
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "values": { "type": "array", "items": { "type": "string" } },
        "min": { "type": "integer" },
        "max": { "type": "integer" },
        "mapping": { "type": "string" }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": ["id", "label", "providerId", "capability"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "providerId": { "$ref": "#/$defs/identifier" },
        "capability": { "$ref": "#/$defs/capability" },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "defaults": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
      },
      "additionalProperties": false
    }
  }
}
